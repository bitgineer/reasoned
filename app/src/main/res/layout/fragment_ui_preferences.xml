<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_24">

        <Button
            android:id="@+id/ui_density"
            style="@style/Widget.Harness.Navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawablePadding="@dimen/space_16"
            android:text="@string/settings_ui_density" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_24"
            android:paddingEnd="@dimen/space_24"
            android:paddingBottom="@dimen/space_16"
            android:text="@string/settings_ui_density_note"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <Button
            android:id="@+id/ui_keyboard"
            style="@style/Widget.Harness.Navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawablePadding="@dimen/space_16"
            android:text="@string/settings_ui_keyboard" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_24"
            android:paddingEnd="@dimen/space_24"
            android:paddingBottom="@dimen/space_16"
            android:text="@string/settings_ui_keyboard_note"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />

        <Button
            android:id="@+id/ui_dock"
            style="@style/Widget.Harness.Navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawablePadding="@dimen/space_16"
            android:text="@string/settings_ui_dock" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_24"
            android:paddingEnd="@dimen/space_24"
            android:paddingBottom="@dimen/space_16"
            android:text="@string/settings_ui_dock_note"
            android:textAppearance="@style/TextAppearance.Harness.Meta" />
    </LinearLayout>
</ScrollView>
